{
  "name": "@adaptivegate/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node --env-file=../../.env dist/index.js",
    "seed": "tsx --env-file=../../.env scripts/seed.ts",
    "create-policy": "tsx --env-file=../../.env scripts/createPolicy.ts",
    "fixture:downstream": "tsx fixtures/downstreamServer.ts",
    "evaluate:live-catalog": "tsx --env-file=../../.env scripts/evaluateLiveCatalog.ts"
  },
  "dependencies": {
    "@adaptivegate/db": "workspace:*",
    "@adaptivegate/governance": "workspace:*",
    "@adaptivegate/recovery": "workspace:*",
    "@adaptivegate/router": "workspace:*",
    "@adaptivegate/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@huggingface/transformers": "^3.2.3",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@supabase/supabase-js": "^2.47.10",
    "drizzle-orm": "^0.38.2",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  }
}
