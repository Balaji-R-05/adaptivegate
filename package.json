{
  "name": "adaptivegate",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @adaptivegate/dashboard run test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @adaptivegate/db run db:generate",
    "db:migrate": "pnpm --filter @adaptivegate/db run db:migrate",
    "benchmark": "pnpm --filter @adaptivegate/benchmark run governance && pnpm --filter @adaptivegate/benchmark run recovery"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
