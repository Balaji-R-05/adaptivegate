# Your Supabase project (find these in Settings -> API and Settings ->
# Database -> Connection string). Use the "Direct connection" string for
# DATABASE_URL, not the pooler - our server is a long-lived process.
# The dashboard gets SUPABASE_URL/SUPABASE_ANON_KEY from the server at
# runtime (GET /api/config), not from its own build - see
# apps/server/src/api/config.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Where the server lives - the dashboard needs this to know where to fetch
# /api/config from, and it's also used in the Connect page's copy-paste snippet.
VITE_GATEWAY_URL=http://localhost:3000

# Where the dashboard lives - only needed if it runs somewhere other than
# the default (a different port, or a real deployment URL).
DASHBOARD_URL=http://localhost:5173

# Restricts sign-in to a specific group - a comma-separated list of emails.
# Leave unset to allow anyone to sign in and use the app, which is normal
# for self-hosting (only you and whoever you give the URL to can reach it).
# Set this if you're running one shared instance for an invited group.
ALLOWED_EMAILS=

# Added in later steps:
# - CREDENTIAL_ENCRYPTION_KEY for encrypting downstream server credentials at rest (gateway, step 3)
# - Embedding provider API key (hybrid router, step 5)

# --- Self-hosted Supabase (optional — see docs/self-hosting.md) ---
# Only needed if you run `docker compose --profile selfhosted up` instead of
# using Supabase Cloud. These values replace SUPABASE_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY and DATABASE_URL above.

# A long random string, shared by the local auth and db containers to sign
# JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# A password for the local Postgres container (any value; stays on your machine).
POSTGRES_PASSWORD=

# Where the dashboard lives - GoTrue needs this for auth redirects.
SITE_URL=http://localhost:5173

# After filling in JWT_SECRET above, run this once to print the two keys to
# paste into SUPABASE_ANON_KEY/SUPABASE_SERVICE_ROLE_KEY:
#   pnpm --filter @adaptivegate/server run generate-supabase-keys -- <JWT_SECRET>

# http://localhost:8000 if you run the server with `pnpm dev` on your host,
# or http://gateway:8000 if the server itself runs as a docker service
# (`docker compose --profile selfhosted up`). See docs/self-hosting.md.

# Similarly: postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/postgres
# on your host, or @db:5432 if the server runs as a docker service.

# Only needed when SUPABASE_URL above is an internal Docker address
# (http://gateway:8000) - the browser can't reach that, so this gives it the
# regular localhost port instead. Leave unset for `pnpm dev` or Supabase Cloud.
SUPABASE_PUBLIC_URL=http://localhost:8000
