# Supabase project (Settings -> API, Settings -> Database -> Connection string).
# DATABASE_URL is the one Drizzle and the server actually connect with - point
# it at Supabase's "Direct connection" string (our server is a long-lived
# process, not serverless, so Direct connection fits better than the pooler).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Same two values as above, re-exposed with the VITE_ prefix Vite requires to
# make an env var readable from browser code (apps/dashboard).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Local Postgres (pgvector) via compose.yml - optional, only needed for fully
# offline dev. Not used by default now that DATABASE_URL points at Supabase.
POSTGRES_USER=adaptivegate
POSTGRES_PASSWORD=adaptivegate
POSTGRES_DB=adaptivegate
POSTGRES_PORT=5432

# Added in later steps:
# - CREDENTIAL_ENCRYPTION_KEY for encrypting downstream server credentials at rest (gateway, step 3)
# - Embedding provider API key (hybrid router, step 5)
